   "right": {"title": "想让它先问", "tone": "m6", "at": "B18.explicit+2.4", "lines": [{"text": "得你明说：「先问我」", "at": "B18.explicit+3.2"}]}},

  {"t": "statement", "at": "B19", "mascot": "left", "icon": "icon-park:shopping-bag", "lines": [
