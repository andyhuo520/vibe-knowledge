    {"text": "只是派活时，要更具体", "at": "B02.same+2.6"}]},
  {"t": "statement", "at": "B02.rule", "w": 1500, "lines": [
    {"text": "OpenAI Codex 文档：好提示的样子", "at": "B02.rule+0.1", "size": 44},
    {"text": "A useful Codex prompt names the behavior you want, points to the relevant code or reproduction steps, preserves important constraints, and says how to verify the change.", "at": "B02.rule+0.8", "size": 42, "weight": 700, "cps": 40, "mt": 26, "color": "var(--ink)"}]},
  {"t": "iconrow", "at": "B02.four", "size": 160, "gap": 60,
