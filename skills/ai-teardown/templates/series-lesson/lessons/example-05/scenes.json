  {"t": "steps", "at": "B13", "title": "好的写法（示例，自拟）", "w": 1560, "items": [
    {"text": "目标", "cmd": "给 scripts/summarize.py 加上按月份汇总，另存为 output/summary_by_month.csv", "plain": true, "at": "B13.t1+0.2"},
    {"text": "背景", "cmd": "数据在 data/sales.csv，日期列叫「日期」，格式如 2026-09-02", "plain": true, "at": "B13.t2+0.2"},
    {"text": "约束", "cmd": "保留原来的按销售员汇总；不要安装新的软件包", "plain": true, "at": "B13.t2+4.6"},
    {"text": "验收", "cmd": "拿 9 月的几行手算合计，和结果对上，把对照贴给我", "plain": true, "at": "B13.t3+0.2"}]},

  {"t": "statement", "at": "B14", "mascot": "left", "icon": "icon-park:bug", "lines": [
    {"text": "不是加功能，而是修问题", "at": "B14.bug+0.1"}, {"text": "*先复现，再修*", "at": "B14.bug+3.2"},
    {"text": "官方：复现步骤和约束，比笼统的描述更重要", "at": "B14.repro+0.4", "size": 44}]},
