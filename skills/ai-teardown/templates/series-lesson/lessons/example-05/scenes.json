    {"icon": "icon-park:rocket", "label": "少走弯路", "sub": "也少费额度", "at": "B07.where+5.6", "color": "m4"}]},
  {"t": "steps", "at": "B07.path", "title": "把「改哪里」告诉它（官方建议）", "w": 1300, "items": [
    {"text": "命令行版：把文件路径写出来", "cmd": "相关文件：只改 index.html", "plain": true, "at": "B07.path+0.3"},
