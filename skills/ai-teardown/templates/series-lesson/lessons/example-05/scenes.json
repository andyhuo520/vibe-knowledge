    {"side": "l", "text": "用中文回复；改完跑检查脚本；别动 photos 文件夹……", "at": "B20@用中文", "typing": 0},
    {"side": "l", "text": "用中文回复；改完跑检查脚本；别动 photos 文件夹……", "at": "B20@用中文+2.6", "typing": 0},
    {"side": "l", "text": "用中文回复；改完跑检查脚本；别动 photos 文件夹……", "at": "B20@用中文+5.2", "typing": 0}],
