    {"text": "约束：哪些不能碰", "at": "B03.i2+0.3"},
    {"text": "验收标准：做到什么算完，用什么检查", "at": "B03.i2+2.4"},
    {"text": "再加一条：做完要汇报", "at": "B03.plus+0.3"}]},

  {"t": "chat", "at": "B04", "chapter": "例子一：团队网页", "title": "给 Codex 派活",
