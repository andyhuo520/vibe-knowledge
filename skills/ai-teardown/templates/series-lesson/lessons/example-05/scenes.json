  {"t": "statement", "at": "B15.official", "w": 1500, "lines": [
    {"text": "OpenAI Codex 文档示例", "at": "B15.official+0.1", "size": 40}, {"text": "Start by reproducing the bug locally, then propose a patch and run checks.", "at": "B15.official+0.8", "size": 46, "weight": 750, "cps": 30},
    {"text": "*先在本地复现，再提出修改，再跑检查*", "at": "B15.official+3.4", "size": 60, "weight": 800, "color": "var(--ink)", "mt": 28}]},

  {"t": "statement", "at": "B16", "chapter": "先出方案，一轮一件", "mascot": "left", "icon": "icon-park:box", "lines": [
    {"text": "需求很大，自己还没想清楚？", "at": "B16.big+0.1"}, {"text": "*别让它直接动手*", "at": "B16.big+2"}]},
  {"t": "steps", "at": "B16.plan", "title": "先让它出方案", "w": 1300, "items": [
    {"text": "在 Codex 里输入", "cmd": "/plan", "plain": true, "see": "它先调查、提出方案，你看过再让它改", "at": "B16.plan+0.6"},
    {"text": "还可以加一句", "cmd": "有影响方案的问题，先问我，最多 5 个。", "plain": true, "at": "B16.askme+0.3"}]},
  {"t": "chat", "at": "B17", "title": "/plan 示例（自拟）",
   "people": {"l": {"name": "你", "icon": "icon-park:user", "color": "m5"}, "r": {"name": "Codex", "icon": "icon-park:robot", "color": "m6"}},
   "messages": [
    {"side": "l", "text": "/plan 我想让团队网页支持中英文切换。", "at": "B17.planex+0.3", "typing": 0},
    {"side": "l", "text": "先看看现在的文字都写在哪里，给我两种做法，以及各自要改哪些文件。", "at": "B17.scan+0.2", "typing": 0},
    {"side": "l", "text": "先别改代码。", "at": "B17.nocode", "typing": 0}],
   "after": {"text": "方案看过、问题答完，*再让它开工*", "at": "B17.review+0.4"}},
  {"t": "statement", "at": "B18", "w": 1500, "lines": [
    {"text": "为什么要特别说「先问我」？", "at": "B18.default+0.1", "size": 52}, {"text": "If some details are missing, make reasonable assumptions and complete a working version of the feature.", "at": "B18.bias+1.5", "size": 40, "weight": 700, "cps": 32, "mt": 26},
    {"text": "*细节缺了，就做合理的假设*", "at": "B18.bias+7", "size": 64, "weight": 800, "color": "var(--ink)", "mt": 22},
    {"text": "OpenAI Cookbook 公开的 Codex 系统提示样例", "at": "B18.bias+0.4", "size": 34}]},
  {"t": "twocol", "at": "B18.explicit",
