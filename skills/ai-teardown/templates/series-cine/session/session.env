# 真实会话录制的配置（turn.sh、export.py、usage.py 都读这个文件）。路径可以用 ~。
# 会话在哪个目录里跑（空目录起步，比如 ~/Desktop/<产品>-promo）
SESSION_PROJ=~/Desktop/demo-promo
# 用哪个 Claude Code：建议单独一份课程实例（独立配置目录、关自动更新），不带入日常配置
SESSION_CC=claude
# 这个实例的配置目录（会话记录在 <配置目录>/projects/ 下）；日常实例就是 ~/.claude
SESSION_CONFIG=~/.claude
# 权限模式（录课用 auto：它自己决定，不弹确认）
SESSION_PERMISSION=auto
# 可选：演示官网（虚构产品的静态站），turn.sh 会自动在这个端口起服务
SITE_DIR=
SITE_PORT=8930
